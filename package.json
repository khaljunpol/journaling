{
  "name": "journaling",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @journaling/web",
    "build": "npm run build -w @journaling/web",
    "lint": "npm run lint -w @journaling/web",
    "test": "npm test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
